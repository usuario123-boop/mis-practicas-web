{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0",
      "config": { "includeFiles": "**" }
    },
    { "src": "index.html",         "use": "@vercel/static" },
    { "src": "pract1/**",          "use": "@vercel/static" },
    { "src": "pract2/**",          "use": "@vercel/static" },
    { "src": "pract4/assets/**",   "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
