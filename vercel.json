{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "pract4/**/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "pract1/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "pract2/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/pract4", "dest": "/pract4/index.php" },
    { "src": "/pract4/", "dest": "/pract4/index.php" },
    { "src": "/pract4/(.*)", "dest": "/pract4/$1" }
  ]
}
