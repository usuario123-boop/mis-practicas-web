{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/pract4/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/pract4", "destination": "/api/pract4/index.php" },
    { "source": "/pract4/", "destination": "/api/pract4/index.php" },
    { "source": "/pract4/(.*)", "destination": "/api/pract4/$1" }
  ]
}
